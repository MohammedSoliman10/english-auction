# Backend runtime config — copy to .env (scripts/deploy.sh writes real values)
PORT=3000
ANVIL_URL=http://127.0.0.1:8545
CHAIN_ID=2026
CHAIN_NAME=English Auction Chain
NFT_ADDRESS=
AUCTION_ADDRESS=
STARTING_BID_WEI=1000000000000000
DURATION_SECONDS=604800
# Auction creation block — activity log pages eth_getLogs from here (T069).
# 0 = read from genesis (fine on a local chain; remote providers cap ranges).
DEPLOY_BLOCK=0
